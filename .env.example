# CIP (Crisis Intelligence Platform) Environment Configuration
# Copy to .env and populate secrets locally or in Vercel Environment Variables.
# NEVER commit real API keys or secrets to GitHub.

# Database & Session Security
DATABASE_URL=sqlite+aiosqlite:///./ai_criss.db
JWT_SECRET_KEY=

# Multi-Provider AI Configuration (Primary: Gemini -> Secondary: OpenRouter -> Tertiary: Groq -> Deterministic Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CIP_AI_PROVIDER_PRIORITY=gemini,openrouter,groq

# Google OAuth 2.0 Authentication (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOWED_ORIGINS=

# OSINT & Global Intelligence Providers (Optional Live Endpoints)
WORLD_INTEL_MCP_URL=
WORLD_INTEL_API_KEY=
WORLD_INTEL_TIMEOUT_SECONDS=10.0
OPENCTI_URL=
OPENCTI_TOKEN=
OPENCTI_TIMEOUT_SECONDS=10.0
OPENCTI_MAX_RETRIES=2
MISP_USE_OPENCTI_CONNECTOR=true
MISP_DIRECT_URL=
MISP_DIRECT_API_KEY=
TRENDRADAR_API_URL=
TRENDRADAR_RSS_FEEDS=
TRENDRADAR_TIMEOUT_SECONDS=10.0
CRAWL4AI_API_URL=
WEB_CRAWLER_TIMEOUT_SECONDS=10.0
OPENOSINT_ENABLED=false
OPENOSINT_API_URL=
OPENOSINT_API_KEY=

# Server Runtime
PORT=8000
HOST=0.0.0.0
